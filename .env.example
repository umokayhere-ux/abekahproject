########################################
# RentFinder — environment configuration
#
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` or any file containing real secrets.
########################################


# ---- Database (required) -------------------------------------------------
# MongoDB Atlas connection string. Include the database name in the path.
# For Vercel, allow access from anywhere (0.0.0.0/0) in Atlas Network Access,
# because serverless functions do not have stable outbound IPs.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/rentfinder?retryWrites=true&w=majority


# ---- Authentication (required) -------------------------------------------
# Secret used to sign JWTs. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 48
# Changing this invalidates every existing session.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars


# ---- Superadmin seeding (optional but recommended) ------------------------
# When all three are set, this account is created on first auth request and
# re-synced on every cold start. There is no other way to create an admin —
# public registration can only create tenants and landlords.
# Leave blank to skip admin seeding entirely.
ADMIN_EMAIL=admin@rentfinder.gh
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_NAME=RentFinder Admin


# ---- Paystack (required for payments) ------------------------------------
# From https://dashboard.paystack.com/#/settings/developers
# Use the test keys (sk_test_… / pk_test_…) during development.
# PAYSTACK_SECRET_KEY is server-only and must never be exposed to the browser.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ---- Cloudinary (required for image uploads) -----------------------------
# From your Cloudinary dashboard. Without these, listing photos can still be
# added by URL but the upload button is disabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ---- Email (optional; required for password resets in production) --------
# Any SMTP provider. Without these, reset links are logged to the server
# console in development and password reset will not work in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="RentFinder <no-reply@rentfinder.gh>"


# ---- Application URL -----------------------------------------------------
# Used to build password-reset links and Paystack callback URLs.
# On Vercel this is inferred automatically; set it explicitly for a custom
# domain. This is the only value that is safe to expose to the client.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ---- Payment configuration (optional) ------------------------------------
# Platform commission percentage, absorbed by the landlord. Default: 10
PLATFORM_COMMISSION_PERCENT=10

# Whether the first payment bundles a security deposit alongside the first
# month's rent, and how many months of rent that deposit is worth.
PAYMENT_INCLUDE_DEPOSIT=true
PAYMENT_DEPOSIT_MONTHS=1
